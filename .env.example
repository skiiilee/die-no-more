# Copy to .env.local and fill in. Server-only: never prefix with NEXT_PUBLIC_.
# Supabase project URL and anon (publishable) key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Email of the single owner account created in the Supabase console (ADR-0003 D2).
OWNER_EMAIL=
# External providers (server-only, ADR-0003 D8). Leave empty until the
# provider check in docs/04-api-design.md is approved.
PLANTNET_API_KEY=
PERENUAL_API_KEY=
TREFLE_TOKEN=
GOOGLE_TRANSLATE_API_KEY=
# Daily call limits per KST day (D8). Proposed values from docs/04-api-design.md.
PLANTNET_DAILY_LIMIT=450
PERENUAL_DAILY_LIMIT=90
TREFLE_DAILY_LIMIT=300
GOOGLE_TRANSLATE_DAILY_LIMIT=200
